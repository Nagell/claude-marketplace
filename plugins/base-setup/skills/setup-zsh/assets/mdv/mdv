#!/usr/bin/env bash
# mdv - view Markdown in Neovim with live reload, search and mouse.
# Config lives in ~/.config/mdv (NVIM_APPNAME=mdv), isolated from ~/.config/nvim.
set -euo pipefail

NVIM="${HOME}/.local/bin/nvim"

if [[ ! -x "${NVIM}" ]]; then
  echo "mdv: neovim not found at ${NVIM}" >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  if [[ -t 0 ]]; then
    echo "usage: mdv FILE.md   |   some-command | mdv" >&2
    exit 1
  fi
  exec env NVIM_APPNAME=mdv "${NVIM}" -R -c 'setfiletype markdown' -
fi

# Inside herdr, record "<this launcher> <absolute paths>" in a per-pane state file so the
# mdv-restore herdr plugin can reopen the same files after a server restart. The file is
# removed only when nvim exits cleanly (q); a killed server or pty leaves it for the plugin.
# State is keyed by the server socket so named sessions never restore into each other.
state_file=""
if [[ -n "${HERDR_PANE_ID:-}" && -n "${HERDR_SOCKET_PATH:-}" ]]; then
  state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/mdv-restore/${HERDR_SOCKET_PATH//[^A-Za-z0-9._-]/_}"
  state_file="${state_dir}/${HERDR_PANE_ID//\//_}"
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  args=()
  for a in "$@"; do
    [[ "$a" != -* && -e "$a" ]] && a="$(cd "$(dirname "$a")" && pwd)/$(basename "$a")"
    args+=("$a")
  done
  mkdir -p "$state_dir" && printf '%s\0' "$self" "${args[@]}" >"$state_file" || state_file=""
fi

status=0
env NVIM_APPNAME=mdv "${NVIM}" -R "$@" || status=$?
[[ -n "$state_file" && "$status" -eq 0 ]] && rm -f "$state_file"
exit "$status"
