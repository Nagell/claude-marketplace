+def codex_launcher(pid, lookup=proc):
+    """The outermost process of the Codex launcher chain the agent runs under.
+
+    npm and Volta start Codex as a `codex` launcher (a shim, then node) that runs the
+    native `codex` binary; without this the launcher reads as an agent above it and
+    every Codex session counts as nested.
+    """
+    top = pid
+    for _ in range(64):
+        info = lookup(pid) if pid and pid > 1 else None
+        parent = lookup(info["ppid"]) if info and info["ppid"] > 1 else None
+        if not parent:
+            break
+        if parent["names"] & AGENTS["codex"]["names"]:
+            top = info["ppid"]
+        elif not parent["names"] & {"node", "bun"}:
+            break
+        pid = info["ppid"]
+    return top
+
+
