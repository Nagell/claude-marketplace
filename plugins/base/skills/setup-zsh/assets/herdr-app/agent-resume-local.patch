+def claude_transcript(session, reported, home=None):
+    """Where Claude Code really keeps this session's conversation.
+
+    Resumed from another folder, Claude Code keeps writing to the project folder the
+    session started in, while its hook reports a path under the new folder."""
+    if os.path.isfile(reported):
+        return reported
+    home = home or os.path.expanduser("~")
+    found = glob.glob(os.path.join(home, ".claude", "projects", "*", glob.escape(session) + ".jsonl"))
+    return found[0] if len(found) == 1 else reported
+
